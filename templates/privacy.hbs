<!DOCTYPE html>
<html lang={{lang}}>
{{> header title=privacy.pageTitle description=privacy.pageDescription canonical=privacy.canonical}}

<body>

<!-- Pre loader -->
{{> preloader}}

<!-- Search START -->
{{> search-start}}
<!-- Search END -->

<!-- =======================
Header START -->
{{> header-start}}
<!-- =======================
Header END -->

<!-- **************** MAIN CONTENT START **************** -->
<main>

  <!-- =======================
  Privacy policy START -->
  <section>
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <h1 class="display-5">{{privacy.heading}}</h1>
          <p class="text-muted">{{privacy.updated}}</p>
          <p class="lead">{{privacy.intro}}</p>
          {{#each privacy.sections}}
          <h4 id="{{id}}" class="mt-5">{{heading}}</h4>
          {{#each paragraphs}}
          <p>{{this}}</p>
          {{/each}}
          {{/each}}
        </div>
      </div>
    </div>
  </section>
  <!-- =======================
  Privacy policy END -->

</main>
<!-- **************** MAIN CONTENT END **************** -->

<!-- =======================
Footer START -->
{{> footer-start}}
<!-- =======================
Footer END -->

<!-- =======================
Cookies alert START -->
{{> cookies-start}}
<!-- =======================
Cookies alert END -->

<!-- Custom cursor -->
{{> custom-cursor}}

<!-- Back to top -->
{{> back-to-top}}

<!-- =======================
JS libraries, plugins and custom scripts -->

<!-- Bootstrap JS -->
{{> bootstrap-js}}

<!-- Template Functions -->
{{> template-functions}}

</body>
</html>
