<!DOCTYPE html>
<html lang={{lang}}>
<head>
  <title>Stranica nije pronađena | Folio</title>

  <!-- Meta Tags -->
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no, viewport-fit=cover">
  <!-- Colour of the browser bar on phones; matches the dark header -->
  <meta name="theme-color" content="#19191c">
  <meta name="robots" content="noindex">

  <!-- This page is served for any missing URL, at any depth, so relative links must resolve from the site root -->
  <base href="/">

  <!-- Favicon -->
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="icon" href="/favicon.ico">

  <!-- Google Font -->
  <link href="https://fonts.googleapis.com/css2?family=Reenie+Beanie&family=Rubik:wght@400;500;700&family=Spartan:wght@400;700;900&display=swap" rel="stylesheet">

  <!-- Plugins CSS -->
  <link rel="stylesheet" type="text/css" href="assets/vendor/font-awesome/css/all.min.css">
  <link rel="stylesheet" type="text/css" href="assets/vendor/bootstrap-icons/bootstrap-icons.css">

  <!-- Theme CSS -->
  <link rel="stylesheet" type="text/css" href="assets/css/style.css">

  <style>
  /* The page draws under the phone's bottom system bar (viewport-fit=cover); keep content clear of it */
  footer { padding-bottom: env(safe-area-inset-bottom); }
  </style>
</head>

<body>

<!-- =======================
Header START -->
{{> header-start}}
<!-- =======================
Header END -->

<!-- **************** MAIN CONTENT START **************** -->
<main>

  <!-- =======================
  Inner intro START -->
  <section class="text-center">
    <div class="container">
      <div class="row">
        <!-- Inner intro title -->
        <div class="col-12 my-5">
          <h1 class="display-2 text-dark-stroke text-primary-shadow">404!</h1>
          <h3>Stranica nije pronađena</h3>
          <p>Stranica koju tražite ne postoji ili je premještena.</p>
        </div>
      </div>
    </div>
  </section>
  <!-- =======================
  Inner intro END -->

  <!-- =======================
  Links START -->
  <section class="bg-light">
    <div class="container">
      <div class="row d-flex justify-content-center">
        <!-- item -->
        <div class="col-md-4 col-lg-3">
          <a href="./" class="bg-white d-block text-center p-3 mb-30 line-draw-animation">
            <div class="line-draw-inner">
              <span class="text-primary display-8"><i class="bi bi-house"></i></span>
              <h5 class="my-2">Povratak na početnu</h5>
            </div>
          </a>
        </div>
        <!-- item -->
        <div class="col-md-4 col-lg-3">
          <a href="{{@root.urls.services}}" class="bg-white d-block text-center p-3 mb-30 line-draw-animation">
            <div class="line-draw-inner">
              <span class="text-primary display-8"><i class="bi bi-briefcase"></i></span>
              <h5 class="my-2">Naše usluge</h5>
            </div>
          </a>
        </div>
        <!-- item -->
        <div class="col-md-4 col-lg-3">
          <a href="{{@root.urls.contact}}" class="bg-white d-block text-center p-3 mb-30 line-draw-animation">
            <div class="line-draw-inner">
              <span class="text-primary display-8"><i class="bi bi-info-square"></i></span>
              <h5 class="my-2">Kontakt</h5>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>
  <!-- =======================
  Links END -->

</main>
<!-- **************** MAIN CONTENT END **************** -->

<!-- =======================
Footer START -->
{{> footer-start}}
<!-- =======================
Footer END -->

<!-- Back to top -->
{{> back-to-top}}

<!-- Bootstrap JS -->
{{> bootstrap-js}}

<!-- Template Functions -->
{{> template-functions}}

</body>
</html>
