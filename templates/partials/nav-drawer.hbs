<!-- Navigation drawer START: the one slide-in menu used on every page -->
<div class="offcanvas offcanvas-end bg-dark" tabindex="-1" id="offcanvasEnd" aria-labelledby="offcanvasEnd" style="background-image:url(assets/images/bg/pattern/03.png); background-position: center left; background-size: cover;">
  <div class="offcanvas-header">
    <a class="ms-auto btn btn-primary btn-round zoom-hover" data-bs-dismiss="offcanvas" aria-label="Close">
      <i class="fas fa-times p-0"></i>
    </a>
  </div>
  <div class="offcanvas-body vh-lg-100 d-flex align-items-start flex-column px-5 px-md-6">
    <!-- Offcanvas inner START -->
    <ul class="nav d-block flex-column mb-5">
      <li class="nav-item display-6 h5">
        <a class="nav-link text-white-stroke text-stroke-clean" href="./">{{home}}</a>
      </li>
      <li class="nav-item display-6 h5">
        <a class="nav-link text-white-stroke text-stroke-clean" href="{{@root.urls.services}}">{{services}}</a>
      </li>
      <li class="nav-item display-6 h5">
        <a class="nav-link text-white-stroke text-stroke-clean" href="{{@root.urls.pricing}}">{{pricing}}</a>
      </li>
      <li class="nav-item display-6 h5">
        <a class="nav-link text-white-stroke text-stroke-clean" href="./#about">{{landing.navProcess}}</a>
      </li>
      <li class="nav-item display-6 h5">
        <a class="nav-link text-white-stroke text-stroke-clean" href="{{@root.urls.contact}}">{{contact}}</a>
      </li>
    </ul>
    <div class="mt-auto mb-5">
      <a href="mailto:{{landing.email}}" class="font-heading text-white text-primary-hover d-block mb-3">{{landing.email}}</a>
      <a href="{{landing.phoneHref}}" class="font-heading text-white text-primary-hover">{{office1_phone}}</a>
    </div>
    <!-- Offcanvas inner END -->
  </div>
</div>
<!-- Navigation drawer END -->
<script>
// Choosing a menu item closes the drawer; needed for links that stay on the same page (./#about)
document.getElementById('offcanvasEnd').addEventListener('click', function (e) {
  if (e.target.closest('a[href]') && window.bootstrap) bootstrap.Offcanvas.getOrCreateInstance(this).hide();
});
</script>
