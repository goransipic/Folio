<div id="cookie-consent" class="alert bg-dark text-white position-fixed start-0 bottom-0 z-index-9 shadow rounded p-4 ms-3 mb-3 col-9 col-md-3 d-none" role="alert">
  {{cookie_text}} <a class="text-white" href="{{@root.urls.privacy}}">{{privacy.link_text}}</a>
  <div class="mt-4">
    <button type="button" id="cookie-accept" class="btn btn-link btn-sm text-white mb-0 ps-0">{{cookie_accept}}</button>
    <button type="button" id="cookie-decline" class="btn btn-link btn-sm text-danger mb-0">{{cookie_decline}}</button>
  </div>
  <div class="position-absolute end-0 top-0 mt-n4 me-n4"><img class="w-100" src="assets/images/cookie.svg" alt="cookie"></div>
</div>
<script>
// Shows the banner until a choice is stored; the defaults live in partials/header.hbs
(function () {
  var banner = document.getElementById('cookie-consent');
  var stored = null;
  try { stored = localStorage.getItem('folio-consent'); } catch (e) {}
  if (stored) return;
  banner.classList.remove('d-none');

  function choose(value) {
    try { localStorage.setItem('folio-consent', value); } catch (e) {}
    banner.classList.add('d-none');
    if (value !== 'granted') return;
    if (typeof gtag === 'function') {
      gtag('consent', 'update', {
        ad_storage: 'granted',
        ad_user_data: 'granted',
        ad_personalization: 'granted',
        analytics_storage: 'granted'
      });
    }
    if (typeof fbq === 'function') fbq('consent', 'grant');
  }

  document.getElementById('cookie-accept').addEventListener('click', function () { choose('granted'); });
  document.getElementById('cookie-decline').addEventListener('click', function () { choose('denied'); });
})();
</script>
