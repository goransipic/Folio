{{#unless showLogout}}
{{> nav-drawer}}
{{/unless}}
<header class="navbar-light header-static navbar-sticky">
  <!-- Logo Nav START -->
  <nav class="navbar navbar-expand-lg">
    <div class="container">
      <!-- Logo START -->
      <a class="navbar-brand" href="./">
        <img class="navbar-brand-item" src="assets/images/logo.png" alt="Logo">
      </a>
      <!-- Logo END -->

      {{#unless showLogout}}
      <!-- Main Menu START: inline on desktop; phones and tablets use the drawer -->
      <div class="collapse navbar-collapse" id="navbarCollapse">
        <ul class="navbar-nav mx-auto">
          <li class="nav-item"><a class="nav-link" href="./">{{home}}</a></li>
          <li class="nav-item"><a class="nav-link" href="{{@root.urls.services}}">{{services}}</a></li>
          <li class="nav-item"><a class="nav-link" href="{{@root.urls.pricing}}">{{pricing}}</a></li>
          <li class="nav-item"><a class="nav-link" href="./#about">{{landing.navProcess}}</a></li>
          <li class="nav-item"><a class="nav-link" href="{{@root.urls.contact}}">{{contact}}</a></li>
        </ul>
      </div>
      {{/unless}}
      <!-- Main Menu END -->

      <!-- Nav right START -->
      <div class="nav flex-nowrap align-items-center">
        <!-- Nav Search Opener-->
        <!--<div class="nav-item">
          <a class="nav-link ms-2" data-bs-toggle="collapse" href="javascript:void(0)" data-bs-target="#search-open">
            <i class="bi bi-search display-9 "> </i>
          </a>
        </div>-->
        <!-- Nav Button -->
        {{#unless showLogout}}
        <div class="nav-item d-none d-xl-block">
          <a href="{{@root.urls.contact}}" class="btn btn-sm btn-primary mb-0 ms-2">{{getQuote}}</a>
        </div>
        <!-- Nav side Opener -->
        <div class="nav-item d-md-block d-xl-none">
          <a class="nav-link pe-0" data-bs-toggle="offcanvas" href="#offcanvasEnd" role="button" aria-controls="offcanvasEnd" aria-label="Menu">
            <i class="bi bi-text-right rtl-flip display-8" data-bs-target="#offcanvasEnd"></i>
          </a>
        </div>
        {{/unless}}
        {{#if showLogout}}
        <!-- Logout button, shown by admin.js when signed in -->
        <div id="header-logout" class="nav-item d-none">
          <button type="button" class="btn btn-sm btn-outline-light mb-0 ms-2"><i class="fas fa-sign-out-alt me-2"></i>Odjava</button>
        </div>
        {{/if}}
      </div>
      <!-- Nav right END -->
    </div>
  </nav>
  <!-- Logo Nav END -->
</header>
