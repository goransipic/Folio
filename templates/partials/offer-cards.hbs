<!-- Service cards with starting prices; pass features=true to list what each service covers -->
<div class="row g-4">
  {{#each offers}}
  <div class="col-sm-6 col-lg-3">
    <div class="card card-body border h-100">
      <i class="display-6 text-primary bi {{icon}}"></i>
      <h5 class="my-3">{{title}}</h5>
      <p>{{text}}</p>
      {{#if ../features}}
      <ul class="list-unstyled small mb-4">
        {{#each features}}
        <li class="mb-1"><i class="bi bi-check2 text-primary me-2"></i>{{this}}</li>
        {{/each}}
      </ul>
      {{/if}}
      <p class="h4 text-primary mt-auto mb-0">{{price}}</p>
    </div>
  </div>
  {{/each}}
</div>
