<!-- **************** MAIN CONTENT START **************** -->
<main>

  <!-- =======================
  Main Banner START -->
  <section class="position-relative bg-dark bg-dark-overlay-4 p-0" style="background-image:url(assets/images/bg/01.jpg); background-position: center center; background-size: cover;">
    <div class="container">
      <div class="row align-items-center hero-row">
        <div class="col-lg-9 pt-7 pb-6">
          <h1 class="display-4 text-white">{{landing.title}}</h1>
          <p class="lead text-white">{{landing.text}}</p>
          <div class="mt-4">
            <a href="{{@root.urls.contact}}" class="btn btn-primary me-2 mb-2">{{landing.primaryButton}}</a>
            <a href="#pricing" class="btn btn-outline-white mb-2">{{landing.secondaryButton}}</a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- =======================
  Main Banner END -->

  <!-- =======================
  Services and pricing START -->
  <section id="services">
    <div class="container">
      <div class="row">
        <!-- Title -->
        <div class="col-lg-8 mb-5">
          <h2 class="display-5">{{landing.servicesTitle}}</h2>
          <p>{{landing.servicesText}}</p>
        </div>
      </div>
      <div id="pricing">
        {{> offer-cards features=true}}
      </div>
      <a href="{{@root.urls.contact}}" class="btn btn-primary mt-5 mb-0">{{landing.primaryButton}}</a>
    </div>
  </section>
  <!-- =======================
  Services and pricing END -->

  <!-- =======================
  Why us START -->
  <section class="bg-dark position-relative pattern-overlay-5 mx-xl-3 mx-xxxl-9 rounded">
    <div class="container">
      <div class="row">
        <!-- Title -->
        <div class="col-md-5 mb-5">
          <h2 class="display-5 text-white">{{landing.whyTitle}}</h2>
          <p>{{landing.whyText}}</p>
        </div>
        <div class="col-md-7">
          <div class="row">
            {{#each landing.why}}
            <div class="col-sm-6 mb-5">
              <i class="display-6 text-primary bi {{icon}}"></i>
              <h5 class="text-white my-3">{{title}}</h5>
              <p class="text-secondary m-0">{{text}}</p>
            </div>
            {{/each}}
          </div>
        </div>
      </div><!-- row END -->
    </div>
  </section>
  <!-- =======================
  Why us END -->

  <!-- =======================
  Steps START -->
  <section id="about">
    <div class="container">
      <div class="row">
        <!-- Title -->
        <div class="col-lg-8 mb-5">
          <h2 class="display-5">{{landing.processTitle}}</h2>
        </div>
      </div>
      <div class="row">
        <!-- Step 1 -->
        <div class="col-md-4 mb-5 mb-md-0">
          <h2 class="display-4 mb-3 text-light-stroke text-light-shadow">01</h2>
          <h4>{{{step1_title}}}</h4>
          <p class="mb-0">{{step1_desc}}</p>
        </div>

        <!-- Step 2 -->
        <div class="col-md-4 mb-5 mb-md-0">
          <h2 class="display-4 mb-3 text-light-stroke text-light-shadow">02</h2>
          <h4>{{{step2_title}}}</h4>
          <p class="mb-0">{{step2_desc}}</p>
        </div>

        <!-- Step 3 -->
        <div class="col-md-4">
          <h2 class="display-4 mb-3 text-light-stroke text-light-shadow">03</h2>
          <h4>{{{step3_title}}}</h4>
          <p class="mb-0">{{step3_desc}}</p>
        </div>
      </div>
    </div>
  </section>
  <!-- =======================
  Steps END -->

  <!-- =======================
  Action box START -->
  <section class="pt-0">
    <div class="container">
      <div class="bg-dark rounded text-center px-3 py-6">
        <h2 class="display-6 text-white mb-3">{{landing.ctaTitle}}</h2>
        <p class="text-white mb-4">{{landing.ctaText}}</p>
        <a href="{{@root.urls.contact}}" class="btn btn-primary mb-0">{{landing.primaryButton}}</a>
        <p class="text-white mt-4 mb-0">{{landing.ctaCall}} <a class="text-white" href="{{landing.phoneHref}}"><u>{{office1_phone}}</u></a></p>
      </div>
    </div>
  </section>
  <!-- =======================
  Action box END -->

</main>
<!-- **************** MAIN CONTENT END **************** -->

<!-- =======================
Footer START -->
{{> footer-start}}
<!-- =======================
Footer END -->

<!-- =======================
Cookies alert START -->
{{> cookies-start}}
<!-- =======================
Cookies alert END -->

<!-- Custom cursor -->
{{> custom-cursor}}

<!-- Back to top -->
